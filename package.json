{
  "name": "navtab-next",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "postinstall": "prisma generate",
    "prepare": "husky install"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.1",
    "@jason-ari/auto-release": "^1.1.3",
    "@neondatabase/serverless": "^1.0.0",
    "@prisma/adapter-neon": "^6.7.0",
    "bcrypt-ts-edge": "^3.0.1",
    "next": "15.2.4",
    "next-auth": "5.0.0-beta.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3",
    "@prisma/client": "^6.7.0",
    "@prisma/extension-accelerate": "^1.3.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.0.9",
    "daisyui": "^5.0.18",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.7.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5",
    "zod": "^3.24.4"
  },
  "lint-staged": {
    "app/**/*.{ts,tsx,js,jsx}": [
      "next lint --fix",
      "prettier --write"
    ],
    "**/*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
